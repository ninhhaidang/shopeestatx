{
  "name": "shopeestatx",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome Extension thống kê chi tiêu Shopee",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:injected": "node scripts/check-injected-scripts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "exceljs": "^4.4.0"
  }
}
