{
  "name": "shopeestatx",
  "version": "3.4.1",
  "private": true,
  "type": "module",
  "description": "Chrome Extension thống kê chi tiêu Shopee",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:injected": "node scripts/check-injected-scripts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "verify": "tsc --noEmit && knip && vitest run --coverage && vite build && npm run check:injected"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.6.1",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
